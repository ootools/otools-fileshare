{
  "name": "otools-fileshare",
  "private": true,
  "type": "module",
  "version": "0.1.5",
  "scripts": {
    "dev": "pnpm --dir web dev",
    "build": "node scripts/build-web.mjs && node scripts/build-native.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "pack": "node scripts/pack-plugin.mjs --out dist-pack",
    "verify": "node scripts/verify-plugin.mjs dist-pack"
  },
  "packageManager": "pnpm@10.15.1"
}
